{
  "name": "phase (a), a2 shrunk to fit $3.50: two pods in one data center, the two systems one after the other on them",
  "results": "results/phase-a",
  "bench": "/workspace/ravex/bench/vs_torchft",
  "data": "/workspace/data",
  "train_args": [
    "--model",
    "124m",
    "--steps",
    "3000",
    "--inner-steps",
    "500",
    "--batch",
    "4",
    "--accum",
    "4",
    "--seq",
    "1024",
    "--eval-batches",
    "32"
  ],
  "arms": [
    {
      "name": "ravex",
      "kind": "ravex",
      "nodes": [
        "pod0",
        "pod1"
      ],
      "port": 29400,
      "ravex_config": "configs/ravex_phase_a.yaml"
    },
    {
      "name": "torchft",
      "kind": "torchft",
      "nodes": [
        "pod0",
        "pod1"
      ],
      "port": 29510,
      "env": {
        "TORCHFT_TIMEOUT_SEC": "900",
        "TORCHFT_QUORUM_TIMEOUT_SEC": "1800",
        "GLOO_SOCKET_IFNAME": "podnet1"
      }
    },
    {
      "name": "ravex-lean",
      "kind": "ravex",
      "nodes": [
        "pod0",
        "pod1"
      ],
      "port": 29402,
      "ravex_config": "configs/ravex_lean.yaml",
      "rounds_root": "/dev/shm"
    },
    {
      "name": "torchft-ckpt",
      "kind": "torchft",
      "nodes": [
        "pod0",
        "pod1"
      ],
      "port": 29511,
      "checkpoint_every": 100,
      "env": {
        "TORCHFT_TIMEOUT_SEC": "900",
        "TORCHFT_QUORUM_TIMEOUT_SEC": "1800",
        "GLOO_SOCKET_IFNAME": "podnet1"
      }
    }
  ],
  "faults": []
}
