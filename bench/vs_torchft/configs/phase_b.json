{
  "name": "phase (b): 2 regions x 2 nodes, R, T and C concurrently, join at 360, kill at 750; then ravex-clock and torchft-hetero one after the other on four pods with different GPUs",
  "results": "results/phase-b",
  "bench": "/workspace/ravex/bench/vs_torchft",
  "data": "/workspace/data",
  "train_args": ["--model", "124m", "--steps", "1200", "--inner-steps", "250",
                 "--batch", "4", "--accum", "4", "--seq", "1024", "--eval-batches", "32"],
  "provision_seconds": 0,
  "on_kill": "echo terminate {host} through the provider here",
  "arms": [
    {"name": "ravex", "kind": "ravex", "nodes": ["r-eu0", "r-eu1", "r-us0", "r-us1"], "port": 29400},
    {"name": "torchft", "kind": "torchft", "nodes": ["t-eu0", "t-eu1", "t-us0", "t-us1"], "port": 29510,
     "env": {"TORCHFT_TIMEOUT_SEC": "900", "TORCHFT_QUORUM_TIMEOUT_SEC": "1800", "GLOO_SOCKET_IFNAME": "podnet1"}},
    {"name": "ckpt", "kind": "ckpt_restart", "nodes": ["c-eu0", "c-eu1", "c-us0", "c-us1"], "port": 29401},
    {"name": "ravex-clock", "kind": "ravex", "nodes": ["h-eu0", "h-eu1", "h-us0", "h-us1"], "port": 29402,
     "ravex_config": "configs/ravex_clock.yaml", "train_args": ["--inner-steps", "100000"]},
    {"name": "torchft-hetero", "kind": "torchft", "nodes": ["h-eu0", "h-eu1", "h-us0", "h-us1"], "port": 29511,
     "env": {"TORCHFT_TIMEOUT_SEC": "900", "TORCHFT_QUORUM_TIMEOUT_SEC": "1800", "GLOO_SOCKET_IFNAME": "podnet1"}}
  ],
  "faults": [
    {"arm": "ravex", "action": "join", "at_step": 360, "host": "r-join"},
    {"arm": "torchft", "action": "join", "at_step": 360, "host": "t-join"},
    {"arm": "ravex", "action": "kill", "at_step": 750, "node": 3},
    {"arm": "torchft", "action": "kill", "at_step": 750, "node": 3},
    {"arm": "ckpt", "action": "kill", "at_step": 750, "node": 3, "host": "c-replacement"},
    {"arm": "ravex-clock", "action": "join", "at_step": 360, "host": "h-join"},
    {"arm": "torchft-hetero", "action": "join", "at_step": 360, "host": "h-join"},
    {"arm": "ravex-clock", "action": "kill", "at_step": 750, "node": 3},
    {"arm": "torchft-hetero", "action": "kill", "at_step": 750, "node": 3}
  ]
}
